{
  "name": "code-mode-mcp",
  "version": "1.0.0",
  "description": "Code Mode MCP server — exposes an entire API in ~1,000 tokens via search() and execute() tools",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "start": "tsx src/server.ts",
    "prod": "node dist/server.js",
    "build": "tsc",
    "dev": "tsx watch src/server.ts",
    "inspect": "npx @modelcontextprotocol/inspector --transport http --server-url http://localhost:1338/mcp",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.141",
    "@blaxel/core": "^0.2.95",
    "@blaxel/telemetry": "^0.2.95",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express": "^4.22.2",
    "quickjs-emscripten": "0.32.0",
    "yaml": "^2.9.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.1",
    "dotenv": "^17.4.2",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
